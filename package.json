{
  "name": "farmacos-fichas",
  "private": true,
  "description": "Fichas de dilución de medicamentos (sitio estático para GitHub Pages)",
  "scripts": {
    "datos": "py herramientas/convertir.py",
    "estilos": "tailwindcss -i herramientas/estilos.entrada.css -o estilos.css --minify",
